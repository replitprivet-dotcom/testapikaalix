{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...all]"
    },
    {
      "source": "/file/(.*)",
      "destination": "/api/[...all]"
    },
    {
      "source": "/rgb/(.*)",
      "destination": "/api/[...all]"
    },
    {
      "source": "/((?!api/|file/|rgb/).*)",
      "destination": "/index.html"
    }
  ]
}
